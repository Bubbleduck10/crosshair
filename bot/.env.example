# A keyed RPC provider. The public endpoint will not work.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Our token.
TARGET_MINT=
TARGET_DECIMALS=6

# Game parameters — must match config.js on the site.
BURN_AMOUNT=300000
COOLDOWN_MS=120000
MIN_HOLD=200000
HOLDER_SHARE=80

# Operator wallet: a Solana CLI keypair JSON. Keep it OUTSIDE this repo.
KEYPAIR_PATH=/absolute/path/to/operator-keypair.json

# Never spend below this SOL balance (transaction fees come from here).
SOL_RESERVE=0.05
SLIPPAGE_BPS=300

# Comma-separated. MUST include your operator wallet and the liquidity pool,
# or you will pay a large share of every distribution to yourself and the pool.
EXCLUDE_WALLETS=
